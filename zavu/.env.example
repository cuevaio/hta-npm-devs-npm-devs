# Solo para pruebas locales (`npx zavudev fn invoke`): se lee automáticamente.
# En producción los valores van como secretos de la función:
#   npx zavudev fn secrets set SENDER_ID <senderId>
#   npx zavudev fn secrets set DOMAIN_API_URL <url>
#   npx zavudev fn secrets set DOMAIN_API_KEY <clave>
#   tools/zavu.sh fn secrets set GEMINI_API_KEY -
SENDER_ID=
# URL base de la Domain API (Prism local o Cloud Run), sin /v1
DOMAIN_API_URL=
# API key de servicio (X-API-Key)
DOMAIN_API_KEY=
# API key de Google AI Studio para Gemini (modelo gemini-4-argon); obligatoria
GEMINI_API_KEY=
