{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleet-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // URL base de la Domain API (Cloud Run, #10), sin barra final.
    "DOMAIN_API_URL": "https://fleet-backend-qp3hzsyoka-uc.a.run.app"
  }
  // Secretos (no van en el repo): `wrangler secret put MCP_API_KEY` y `wrangler secret put DOMAIN_API_KEY`.
}
